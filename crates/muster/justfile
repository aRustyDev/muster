# muster — the application

default:
    @just --list

test:
    cargo nextest run -p muster --all-features

# (fixed 2026-08-02, plan-review MO-10: the recipe passed `--features e2e`
# but no such cargo feature exists — the e2e_ family is selected by name)
e2e:
    cargo nextest run -p muster -E 'test(e2e_)'

run:
    cargo run -p muster

# (run-dev removed 2026-08-03, QF slice / QR-2 M-7, F-9: its
# ORRERY_OTEL_EXPORTER knob was dead — this crate has no tracing or
# figment dependency. The live twin is `just muster_server::run-dev`;
# subscriber ownership is corrected in Rule 05 by the QR-3 amendment.)

lint:
    cargo clippy -p muster --all-targets --all-features -- -D warnings
