# muster — the application

default:
    @just --list

test:
    cargo nextest run -p muster --all-features

e2e:
    cargo nextest run -p muster --features e2e -E 'test(e2e_)'

run:
    cargo run -p muster

# development: stdout exporter, no collector required (Rule 05)
run-dev:
    ORRERY_OTEL_EXPORTER=stdout cargo run -p muster

lint:
    cargo clippy -p muster --all-targets --all-features -- -D warnings
